# Only needed when running `npm run audio` (build-time audio generation).
# The deployed site never reads these — it just serves the MP3s in public/audio.

# --- Option A: Google Cloud Text-to-Speech (default, simplest) ---
# Enable "Cloud Text-to-Speech API" in a GCP project, then create an API key.
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=
# Voices worth trying: ko-KR-Neural2-A (female), ko-KR-Neural2-C (male),
# ko-KR-Wavenet-A, ko-KR-Chirp3-HD-Leda
GOOGLE_TTS_VOICE=ko-KR-Neural2-A

# --- More than one voice (recommended) ---
# Letter names and demo syllables are also rendered in every voice listed
# here, as <key>-v2.mp3, <key>-v3.mp3 …, and the quiz picks one at random per
# question. Training a contrast against a single recording teaches the
# recording: the learner tells two waveforms apart and it does not carry to a
# real speaker. The first entry is the main voice.
# TTS_VOICES=ko-KR-Neural2-A,ko-KR-Neural2-C,ko-KR-Wavenet-B

# --- Option B: Azure AI Speech ---
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# AZURE_TTS_VOICE=ko-KR-SunHiNeural

# --- Option C: ElevenLabs ---
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
